# Local API (pnpm dev). Copy to .env; everything is optional for local work.
# Without DATABASE_URL the dev server uses PGlite on disk (.pglite) and seeds sample nights.
ADMIN_TOKEN=dev-admin-token
WEB_ORIGIN=http://localhost:3000
# TURNSTILE_SECRET=
# LASTFM_API_KEY=
# LASTFM_USER=

# Only for db:migrate / db:seed against a real database (for example a Neon branch):
# DATABASE_URL=postgres://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
