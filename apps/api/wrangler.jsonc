{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "4me-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Public, non-secret settings. Secrets (DATABASE_URL, ADMIN_TOKEN, IP_SALT, TURNSTILE_SECRET, LASTFM_API_KEY)
  // are set with `wrangler secret put` or by the deploy workflow.
  "vars": {
    "WEB_ORIGIN": "https://4me.vercel.app",
    "LASTFM_USER": ""
  }
}
