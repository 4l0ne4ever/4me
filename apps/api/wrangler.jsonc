{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "4me-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Live updates: one Durable Object holds every browser's WebSocket (SQLite-backed, so it runs on the free plan).
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // Public, non-secret settings. Secrets are set by the deploy workflow (DATABASE_URL, ADMIN_TOKEN, IP_SALT) or
  // once by hand (TURNSTILE_SECRET, LASTFM_API_KEY, and the photo bucket: S3_ENDPOINT, S3_REGION,
  // S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY).
  "vars": {
    "WEB_ORIGIN": "https://4me.vercel.app",
    "LASTFM_USER": ""
  }
}
