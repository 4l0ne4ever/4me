{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "4me-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Live updates: one Durable Object holds every browser's WebSocket (SQLite-backed, so it runs on the free plan).
  // Werewolf: one object per table (players' sockets, the game, its clock), and one listing the open tables.
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "Hub" },
      { "name": "TABLES", "class_name": "GameTable" },
      { "name": "TABLE_LOBBY", "class_name": "TableLobby" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Hub"] },
    { "tag": "v2", "new_sqlite_classes": ["GameTable", "TableLobby"] }
  ],
  // Sealed letters whose day has come are announced every ten minutes.
  "triggers": { "crons": ["*/10 * * * *"] },
  // Public, non-secret settings. Secrets are set by the deploy workflow (DATABASE_URL, ADMIN_TOKEN, IP_SALT) or
  // once by hand (TURNSTILE_SECRET, LASTFM_API_KEY, and the photo bucket: S3_ENDPOINT, S3_REGION,
  // S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY; optionally TURN_KEY_ID and TURN_KEY_API_TOKEN for the werewolf tables'
  // voice).
  // The API answers at https://api.2die429.com, a Custom Domain attached to this Worker in the dashboard (Workers &
  // Pages → 4me-api → Settings → Domains & Routes); workers.dev keeps working too.
  "vars": {
    "WEB_ORIGIN": "https://2die429.com",
    "LASTFM_USER": ""
  }
}
