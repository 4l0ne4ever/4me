# Copy to .env.local for local work. In production set these in the Vercel project.
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Author login (server only)
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=at-least-sixteen-random-characters
# Must match the API's ADMIN_TOKEN
ADMIN_TOKEN=dev-admin-token
