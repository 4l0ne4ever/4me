# Copy to .env.local for local work. In production set these in the Vercel project.
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Signs readers' session cookies. 32+ random characters: openssl rand -base64 48
SESSION_SECRET=change-me-to-at-least-thirty-two-random-characters

# Author login (server only)
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=at-least-sixteen-random-characters
# Must match the API's ADMIN_TOKEN; also authorises the web server's account calls to the API
ADMIN_TOKEN=dev-admin-token

# Optional: "Continue with Google". Redirect URI: <NEXT_PUBLIC_SITE_URL>/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: password reset emails through Resend
# RESEND_API_KEY=
# MAIL_FROM=4me <night@your-domain.com>
